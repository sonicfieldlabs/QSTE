        },
        "assessment_identity": {
          "minProperties": 1,
          "type": "object"
        },
        "assessment_status": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/assessment_status"
        },
        "assessor": {
          "minLength": 1,
          "type": "string"
        },
        "authorization_status": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/authorization_status"
        },
        "candidate_interval": {
          "minProperties": 1,
          "type": "object"
        },
        "candidate_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "candidate_semantic_key": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/semanticKey"

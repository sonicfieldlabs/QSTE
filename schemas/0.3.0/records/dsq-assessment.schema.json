          "minProperties": 1,
          "type": "object"
        },
        "negative_evidence_valid": {
          "type": "boolean"
        },
        "oriented_effects": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "type": "array"
        },
        "proper_node_intervals": {
          "items": {},
          "minItems": 1,
          "type": "array"
        },
        "qualification_ready": {
          "type": "boolean"

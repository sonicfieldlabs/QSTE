        "candidate_ref",
        "candidate_semantic_key",
        "representation_instance_ref",
        "native_address",
        "apparatus_ref",
        "aperture_ref",
        "representation_family_ref",
        "intervention_ref",
        "task_ref",
        "refinement_graph_ref",
        "raw_effects",
        "oriented_effects",
        "candidate_interval",
        "proper_node_intervals",
        "meaningful_bound",
        "equivalence_region",
        "comparison_operators",
        "tested_proper_nodes",
        "closure_certificate",
        "selection_evidence",
        "multiplicity_evidence",
        "artifact_control_results",
        "well_formed",
        "negative_evidence_valid",
        "qualification_ready",
        "assessment_status",
        "reason_code",
        "interaction_annotations",
        "dependency_validity",
        "authorization_status",
        "evidence_refs",
        "assessor",
        "versions",
        "receipt_refs",
        "semantic_key"

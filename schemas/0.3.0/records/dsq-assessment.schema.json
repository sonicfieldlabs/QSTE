        "contract_id": {
          "const": "qste-contract/0.3.0"
        },
        "dependency_validity": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/dependency_validity"
        },
        "equivalence_region": {
          "minProperties": 1,
          "type": "object"
        },
        "evidence_refs": {
          "items": {
            "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"

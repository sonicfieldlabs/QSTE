{
  "$id": "https://schemas.qste.invalid/0.3.0/records/decision-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordBase"
    },
    {
      "properties": {
        "alternatives": {
          "items": {},
          "minItems": 1,
          "type": "array"
        },
        "authority_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "budget": {
          "minProperties": 1,
          "type": "object"
        },
        "cited_evidence": {
          "items": {},
          "minItems": 1,
          "type": "array"
        },
        "contract_id": {
          "const": "qste-contract/0.3.0"
        },
        "decision_action": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/decision_action"
        },
        "event_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "executable_consequence": {
          "minProperties": 1,
          "type": "object"
        },
        "governance_boundary_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "leakage_checks": {
          "minProperties": 1,
          "type": "object"
        },
        "next_run_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "opportunity_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "predecessor_successor_diff": {
          "minProperties": 1,
          "type": "object"
        },
        "reason_code": {
          "minLength": 1,
          "type": "string"
        },
        "receipt_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "record_type": {
          "const": "DecisionEvent"
        },
        "revision_treatment": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/revision_treatment"
        },
        "schema_id": {
          "const": "https://schemas.qste.invalid/0.3.0/records/decision-event.schema.json"
        }
      },
      "required": [
        "opportunity_ref",
        "revision_treatment",
        "alternatives",
        "cited_evidence",
        "reason_code",
        "authority_ref",
        "governance_boundary_ref",
        "decision_action",
        "predecessor_successor_diff",
        "executable_consequence",
        "next_run_ref",
        "budget",
        "leakage_checks",
        "receipt_ref",
        "event_sequence"
      ],
      "type": "object"
    }
  ],
  "patternProperties": {
    "^[a-z][a-z0-9_-]*:[A-Za-z][A-Za-z0-9_.-]*$": {}
  },
  "title": "DecisionEvent",
  "unevaluatedProperties": false
}

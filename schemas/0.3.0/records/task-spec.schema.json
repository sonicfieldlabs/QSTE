  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordBase"
    },
    {
      "properties": {
        "alternate_intervention": {
          "minProperties": 1,
          "type": "object"
        },
        "artifact_controls": {
          "items": {},
          "minItems": 1,
          "type": "array"
        },
        "bound_validity_evidence": {
          "minProperties": 1,
          "type": "object"
        },
        "boundary_semantics": {
          "minProperties": 1,
          "type": "object"
        },
        "compute_budget": {
          "minProperties": 1,
          "type": "object"
        },
        "contract_id": {
          "const": "qste-contract/0.3.0"
        },
        "contrast_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "eligible_family": {
          "items": {},
          "minItems": 1,
          "type": "array"
        },
        "equivalence_region": {
          "minProperties": 1,
          "type": "object"
        },
        "estimator": {
          "minProperties": 1,
          "type": "object"
        },
        "expected_effect_direction": {
          "enum": [
            -1,
            1
          ],
          "type": "integer"
        },
        "failure_reasons": {
          "items": {},
          "minItems": 1,
          "type": "array"
        },
        "fixed_context": {
          "minProperties": 1,
          "type": "object"
        },
        "input_refs": {
          "items": {
            "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"

      "required": [
        "task_id",
        "task_version",
        "response_variable",
        "input_refs",
        "fixed_context",
        "contrast_ref",
        "intervention_ref",
        "expected_effect_direction",
        "response_units",
        "meaningful_bound",
        "equivalence_region",
        "bound_validity_evidence",
        "boundary_semantics",
        "estimator",
        "repeats",
        "seeds",
        "uncertainty",
        "multiplicity",
        "stopping_rules",
        "selection_confirmation",
        "eligible_family",
        "artifact_controls",
        "alternate_intervention",
        "compute_budget",
        "success_criterion",
        "failure_reasons"

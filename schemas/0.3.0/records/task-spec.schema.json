          "const": "https://schemas.qste.invalid/0.3.0/records/task-spec.schema.json"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "selection_confirmation": {
          "minProperties": 1,
          "type": "object"
        },
        "stopping_rules": {
          "minProperties": 1,
          "type": "object"
        },
        "success_criterion": {
          "minProperties": 1,
          "type": "object"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        },
        "task_version": {
          "minLength": 1,
          "type": "string"
        },
        "uncertainty": {
          "minProperties": 1,
          "type": "object"
        }

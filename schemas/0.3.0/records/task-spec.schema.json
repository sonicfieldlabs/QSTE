        "intervention_ref": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordReference"
        },
        "meaningful_bound": {
          "minimum": 0,
          "type": "number"
        },
        "multiplicity": {
          "minProperties": 1,
          "type": "object"
        },
        "record_type": {
          "const": "TaskSpec"

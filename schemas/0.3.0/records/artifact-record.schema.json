{
  "$id": "https://schemas.qste.invalid/0.3.0/records/artifact-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/recordBase"
    },
    {
      "properties": {
        "artifact_availability": {
          "$ref": "https://schemas.qste.invalid/0.3.0/common.schema.json#/$defs/availability"
        },
        "byte_state": {
          "minLength": 1,
          "type": "string"
        },
        "contract_id": {
          "const": "qste-contract/0.3.0"
        },
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "record_type": {
          "const": "ArtifactRecord"
        },
        "schema_id": {
          "const": "https://schemas.qste.invalid/0.3.0/records/artifact-record.schema.json"
        }
      },
      "required": [
        "media_type",
        "artifact_availability",
        "byte_state"
      ],
      "type": "object"
    },
    {
      "anyOf": [
        {
          "required": [
            "content_digest"
          ]
        },
        {
          "properties": {
            "artifact_availability": {
              "enum": [
                "unknown",
                "unavailable",
                "withheld",
                "deleted"
              ]
            }
          }
        }
      ]
    }
  ],
  "patternProperties": {
    "^[a-z][a-z0-9_-]*:[A-Za-z][A-Za-z0-9_.-]*$": {}
  },
  "title": "ArtifactRecord",
  "unevaluatedProperties": false
}
